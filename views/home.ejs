<html>

<head>
    <title>house</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include('partials/navbar') %>

        <h1>
            <%= property.title %>
        </h1>
        <div class="house">


            <div>


                <a href="/">
                    <img src="<%=property.image_url %>" alt="<%= property.alt_text %>">
                </a>
            </div>
            <div class="house-info">

                <% if (property.city) {%>
                    <p>Location: <%= property.city %>
                    </p>
                    <% }%>

                        <% if (property.description) {%>
                            <p>Description: <%= property.description %>
                            </p>
                            <% }%>

                                <% if (property.internalArea) {%>
                                    <p> Internal area: <%= property.internalArea %> m&#178;</p>
                                    </p>
                                    <% }%>

                                        <% if (property.totalPlotArea) {%>
                                            <p>Total plot area: <%= property.totalPlotArea %> m&#178;</p>
                                            <% }%>

                                                <% if (property.price) {%>
                                                    <p>Price: &#8364; <%= property.price %> m&#178;</p>
                                                    <% }%>

                                                        <% if (property.type) {%>
                                                            <p>Type: <%= property.type %>
                                                            </p>
                                                            <% }%>

                                                                <% if (property.floors) {%>
                                                                    <p>Floors: <%= property.floors %>
                                                                    </p>
                                                                    <% }%>
                                                                        <% if (property.status) {%>
                                                                            <p>Status: <%= property.status %>
                                                                            </p>
                                                                            <% }%>





            </div>


        </div>
</body>

</html>