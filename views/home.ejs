<html>

<head>
    <title>house</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include('partials/navbar') %>
        <div class="house">
            <div>
                <a href="/">
                    <img src="<%=hm.image %>" alt="house">
                </a>
            </div>
            <div class="house-info">

                <% if (hm.location) {%>
                    <p>Location: <%= hm.location %>
                    </p>
                    <% }%>

                        <% if (hm.description) {%>
                            <p>Description: <%= hm.description %>
                            </p>
                            <% }%>

                                <% if (hm.internalArea) {%>
                                    <p> Internal area: <%= hm.internalArea %> m&#178;</p>
                                    </p>
                                    <% }%>

                                        <% if (hm.totalPlotArea) {%>
                                            <p>Total plot area: <%= hm.totalPlotArea %> m&#178;</p>
                                            <% }%>

                                                <% if (hm.price) {%>
                                                    <p>Price: &#8364; <%= hm.price %> m&#178;</p>
                                                    <% }%>

                                                        <% if (hm.type) {%>
                                                            <p>Type: <%= hm.type %>
                                                            </p>
                                                            <% }%>

                                                                <% if (hm.floors) {%>
                                                                    <p>Floors: <%= hm.floors %>
                                                                    </p>
                                                                    <% }%>
                                                                        <% if (hm.status) {%>
                                                                            <p>Status: <%= hm.status %>
                                                                            </p>
                                                                            <% }%>





            </div>


        </div>
</body>

</html>