<html>

<head>
    <title>house</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include('../partials/navbar') %>

        <h1>
            <%= property.title %>
        </h1>
        <div class="house">


            <div>
                <br>
                <% images.forEach(image=> { %>
                    <%= image.image_url %>
                        <% }) %>
                            <hr>
                            <br>
                            <% images.forEach(image=> { %>
                                <img src="<%= image.image_url %>" alt="<%= property.title %>">
                                <% }) %>

            </div>
            <br>
            <hr>
            <br>
            <div class="house-info">

                <% if (property.city) {%>
                    <p>City: <%= property.city %>
                    </p>
                    <% }%>

                        <% if (property.description) {%>
                            <p>Description: <%= property.description %>
                            </p>
                            <% }%>

                                <% if (property.internal_area) {%>
                                    <p> Internal area: <%= property.internal_area %> m&#178;</p>
                                    </p>
                                    <% }%>

                                        <% if (property.total_plot_area) {%>
                                            <p>Total plot area: <%= property.total_plot_area %> m&#178;</p>
                                            <% }%>

                                                <% if (property.price) {%>
                                                    <p>Price: &#8364; <%= property.price %>
                                                    </p>
                                                    <% }%>

                                                        <% if (property.type) {%>
                                                            <p>Type: <%= property.type %>
                                                            </p>
                                                            <% }%>

                                                                <% if (property.floors) {%>
                                                                    <p>Floors: <%= property.floors %>
                                                                    </p>
                                                                    <% }%>
                                                                        <% if (property.status) {%>
                                                                            <p>Status: <%= property.status %>
                                                                            </p>
                                                                            <a
                                                                                href="/properties/<%= property.id %>/edit">
                                                                                <button>Edit Property</button>
                                                                            </a>

                                                                            <% }%>





            </div>


        </div>
</body>

</html>