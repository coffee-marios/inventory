<html>

<head>
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <%- include('../partials/navbar') %>

    <div>
      public | properties | table | marios
      <br>
      public | property_images | table | marios
    </div>
    <div>

      <% properties.forEach((property)=> { %>


        <div class="house">
          <div>
            <a href="/properties/home/<%= property.id %>">
              <img src="<%= property.image_url %>" alt="<%= property.title %>">
            </a>
          </div>
          <div class="house-info">
            <p>City: <%= property.city %>
            </p>
            <p>Price: &#8364; <%= property.price %>
            </p>
            <a class="btn" href="/properties/home/<%= property.id %>">More</a>
          </div>
          <!-- <form action="/properties/<%= property.id %>/delete" method="POST"
            onsubmit="return confirm('Delete this property?');">
            <button type="submit">
              Delete Property
            </button>
          </form> -->





        </div>
        <br>

        <% }) %>


          <br>




</body>

</html>