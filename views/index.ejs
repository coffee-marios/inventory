<html>

<head>
  <title>Homepage</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <%- include('partials/navbar') %>
    <div>

      <% properties.forEach((property, index)=> {%>
        <div class="house">
          <div><a href="/home/<%= index %>">
              <img src=<%=property.image %> alt="house">
            </a>
          </div>
          <div class="house-info">
            <p>Location: <%= property.location %>
            </p>
            <p>Price: &#8364; <%= property.price %>
            </p>

          </div>
        </div>



        <% }) %>

          <div class="house">
            <a href="home">
              <img src="./pictures/house1.png" alt="house">
            </a>

            <div class="house-info">

              <p> Location: Limassol</p>

              <p> Price: &#8364; 1.222.434</p>
              <p>Property type: house</p>

              <p>Description: N/A</p>
              <p>Status: for sale</p>


            </div>


          </div>
</body>

</html>