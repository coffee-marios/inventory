<html>

<head>
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <%- include('partials/navbar') %>

    <div>
      public | properties | table | marios
      <br>
      public | property_images | table | marios
    </div>
    <div>

      <% properties.forEach((property, index)=> { %>


        <div class="house">
          <div>
            <a href="/home/<%= index+1 %>">
              <img src="<%= property.image_url %>" alt="<%= property.alt_text %>">
            </a>
          </div>
          <div class="house-info">
            <p>City: <%= property.city %>
            </p>
            <p>Price: &#8364; <%= property.price %>
            </p>
          </div>

        </div>
        <br>

        <% }) %>


          <br>




</body>

</html>